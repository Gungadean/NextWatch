# [Host]
SCHEME=http
HOST=localhost
PORT=8000
API_PREFIX=/api/v1

# [Auth]
SECRET_ACCESS=<paste_generated_token_here>
SECRET_REFRESH=<paste_generated_token_here>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# [CORS]
ALLOW_ORIGINS=["http://localhost"]
ALLOW_CREDENTIALS=True
ALLOW_METHODS=["*"]
ALLOW_HEADERS=["*"]

# [Database]
DATABASE_URL=sqlite:////app/data/database.db

# [Dev]
DEBUG=True